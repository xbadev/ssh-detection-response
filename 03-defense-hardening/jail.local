# Fail2Ban — SSH jail.
#
# Path on target: /etc/fail2ban/jail.local
# Reload with:    sudo systemctl restart fail2ban
#
# Defense-in-depth alongside the Phase 04 detector. Both read the same
# source (the systemd journal); they have different jobs:
#   - Phase 04 detector alerts at DETECT_THRESHOLD (3) failures
#   - Fail2Ban bans at maxretry (5) failures
#
# The ordering is deliberate. If Fail2Ban banned first, the attacker
# would be cut off before the detector saw enough failures to alert,
# and the notification half of the pipeline would never fire.

[sshd]
enabled  = true
port     = ssh
filter   = sshd
backend  = systemd
maxretry = 5
findtime = 60
bantime  = 600

# backend = systemd reads the journal directly, so this works on Ubuntu
# installs that have no /var/log/auth.log (rsyslog not installed).
# With the systemd backend, logpath is ignored, so it is not set here.
