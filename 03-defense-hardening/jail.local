# Fail2Ban — SSH jail.
#
# Path on target: /etc/fail2ban/jail.local
# Reload with:    sudo systemctl restart fail2ban
#
# This jail provides defense-in-depth at the IP-table layer.
# Our Phase 04 journald-based detector runs alongside it; the two
# are intentionally redundant — Fail2Ban enforces, the detector observes
# and notifies. If one fails, the other still catches the attack.

[sshd]
enabled  = true
port     = ssh
filter   = sshd
backend  = systemd
logpath  = %(sshd_log)s
maxretry = 3
findtime = 60
bantime  = 600

# backend = systemd is important on modern Ubuntu where /var/log/auth.log
# may be absent. It tells Fail2Ban to read the journal directly,
# matching the same data source the Phase 04 detector uses.
