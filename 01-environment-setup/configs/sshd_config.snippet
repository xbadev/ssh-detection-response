# SSH Daemon — Lab Hardening Drop-in
#
# Path on target: /etc/ssh/sshd_config.d/10-lab.conf
# Validate first: sudo sshd -t
# Then reload:    sudo systemctl reload ssh
#
# Why the "10-" prefix: for most sshd options the FIRST value read wins,
# and Ubuntu includes sshd_config.d/*.conf in lexical order before the
# main sshd_config. 10-lab.conf therefore beats files like
# 50-cloud-init.conf, which sets PasswordAuthentication no on some images.
#
# Password authentication is intentionally LEFT ENABLED. The lab
# simulates password brute-force; disabling it would make the attack
# impossible by design. In production: PasswordAuthentication no.

# No direct root login. An attacker has to compromise an unprivileged
# account first, then escalate — an extra, auditable step.
PermitRootLogin no

PasswordAuthentication yes
PubkeyAuthentication yes

# Only this account may authenticate at all. MUST match LAB_USER in
# lab.env AND the account you log in with — if it doesn't, you lock
# yourself out of SSH (use the Proxmox console to recover).
AllowUsers bader

# Less time per connection, fewer password tries per connection.
LoginGraceTime 20
MaxAuthTries 3
MaxSessions 2

# No Banner: a banner naming the system helps an attacker fingerprint it.
