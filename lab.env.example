# ============================================================
# SSH Detection & Response — Lab Configuration
# ============================================================
# Real version path: /etc/ssh-detection-response/lab.env
# Installed by:      sudo make install  (mode 0640, root:ssh-dr)
#
# Every script and systemd unit in this repo reads from this file.
# Change the lab once, rebuild nothing.
# ============================================================

# --- Network ------------------------------------------------
# Internal lab subnet (vmbr1 on Proxmox). Attack traffic lives here.
INTERNAL_SUBNET="10.10.10.0/24"

# Management subnet: wherever YOU SSH into the target from to administer it
# (usually your home LAN on vmbr0). install-ufw.sh allows SSH from this
# subnet too, so enabling the firewall doesn't lock you out.
# Leave empty ("") only if you administer the VM from the Proxmox console.
MGMT_SUBNET="192.168.1.0/24"

# Static IPs assigned in Proxmox.
TARGET_IP="10.10.10.20"      # Ubuntu Server (the target)
ATTACKER_IP="10.10.10.30"    # Kali (the attacker)

# --- Identity -----------------------------------------------
# The login account on the Ubuntu target that the attack goes after.
# Used by run-attack.sh (Hydra -l) and must match AllowUsers in the
# sshd drop-in. The detector/responder do NOT run as this user; they
# run as the ssh-dr service account created by `make install`.
LAB_USER="bader"

# --- Detection tuning ---------------------------------------
# Alert when this many failed SSH logins come from one source IP
# within DETECT_WINDOW_SECONDS.
#
# Kept BELOW Fail2Ban's maxretry (5, see 03-defense-hardening/jail.local)
# on purpose: the detector alerts at 3 failures, then Fail2Ban bans at 5.
# If the detector threshold were >= maxretry, Fail2Ban would ban the
# attacker before the detector ever saw enough failures to alert.
DETECT_THRESHOLD="3"
DETECT_WINDOW_SECONDS="60"

# How long the in-memory sliding window keeps events (seconds).
# Must be >= DETECT_WINDOW_SECONDS.
DETECT_RETENTION_SECONDS="600"

# --- Response -----------------------------------------------
# Webhook URL for alert delivery. Discord, Slack, or any service
# that accepts a POST with {"content": "..."}.
# DO NOT commit the real value — only this example file is committed.
ALERT_WEBHOOK_URL="https://discord.com/api/webhooks/REPLACE_ME"

# Per-source-IP cooldown (seconds) for webhook notifications.
RESPONSE_COOLDOWN_SECONDS="300"

# --- Paths --------------------------------------------------
# Runtime state and alert files. systemd creates these on first start.
LAB_STATE_DIR="/var/lib/ssh-detection-response"
LAB_LOG_DIR="/var/log/ssh-detection-response"
