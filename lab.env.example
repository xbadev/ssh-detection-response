# ============================================================
# SSH Detection & Response — Lab Configuration
# ============================================================
# Real version path: /etc/ssh-detection-response/lab.env
# Permissions:       chmod 600 (contains webhook secret)
# Owner:             root:root
#
# Every script and systemd unit in this repo reads from this file.
# Change the lab once, rebuild nothing.
# ============================================================

# --- Network ------------------------------------------------
# Internal lab subnet (vmbr1 on Proxmox). Used by UFW rules.
INTERNAL_SUBNET="10.10.10.0/24"

# Static IPs assigned in Proxmox.
TARGET_IP="10.10.10.20"      # Ubuntu Server (this host)
ATTACKER_IP="10.10.10.30"    # Kali (the attacker VM)

# Internal NIC name on the Ubuntu target. On Proxmox/VirtIO,
# typical names are ens18 (vmbr0/internet) and ens19 (vmbr1/internal).
# Verify with `ip -br addr` on the target.
INTERNAL_IFACE="ens19"
EXTERNAL_IFACE="ens18"

# --- Identity -----------------------------------------------
# Local user the detector/responder run as. Must exist on the
# target with read access to the systemd journal (group 'systemd-journal').
LAB_USER="bader"

# --- Detection tuning ---------------------------------------
# Trigger an alert when this many failed SSH logins occur from
# a single source IP within DETECT_WINDOW_SECONDS.
DETECT_THRESHOLD="5"
DETECT_WINDOW_SECONDS="60"

# How long the in-memory sliding window retains events (seconds).
# Should be >= DETECT_WINDOW_SECONDS. Larger values use more memory
# but allow detecting slower attacks.
DETECT_RETENTION_SECONDS="600"

# --- Response -----------------------------------------------
# Webhook URL for alert delivery. Discord, Slack, or any service
# that accepts a POST with {"content": "..."}.
# DO NOT commit the real value — only the example file is committed.
ALERT_WEBHOOK_URL="https://discord.com/api/webhooks/REPLACE_ME"

# Cooldown per source IP (seconds). Suppresses repeat notifications
# for the same attacker within this window.
RESPONSE_COOLDOWN_SECONDS="300"

# --- Paths --------------------------------------------------
# Runtime state and alert files. Created at first run.
LAB_STATE_DIR="/var/lib/ssh-detection-response"
LAB_LOG_DIR="/var/log/ssh-detection-response"
